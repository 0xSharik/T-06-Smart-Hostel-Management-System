# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────
# Runtime connection. For Neon pooled URLs, append pgbouncer=true.
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/hostel_db"
# Direct connection used by Prisma migrations. For local PostgreSQL, use the same URL.
DIRECT_URL="postgresql://postgres:yourpassword@localhost:5432/hostel_db"

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Cookie ───────────────────────────────────────────────
COOKIE_SECRET=your_cookie_secret_change_this_in_production

# ─── CORS ─────────────────────────────────────────────────
# Frontend URL (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173

# ─── Bcrypt ───────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10
